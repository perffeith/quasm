// value.f(args) calls f(value, args)
// Type.f(args) calls f(args) - can imitate methods

struct Point {
    x: Float
    y: Float
}

struct Counter {
    count: Int
    step: |func(Int): Int|
}

func new(x: Float, y: Float): Point {
    return Point(x, y)
}

func origin(): Point {
    return Point(0.0, 0.0)
}

func scale(p: Point, factor: Float): Point {
    return Point(p.x * factor, p.y * factor)
}

func dot(a: Point, b: Point): Float {
    return a.x * b.x + a.y * b.y
}

func double(n: Int): Int {
    return n * 2
}

func main() {
    // Type.f(args) is just f(args)
    local p = Point.new(3.0, 4.0)
    local o = Point.origin()

    // value.f(args) is f(value, args)
    local doubled = scale(p, 2.0)
    local same = p.scale(2.0)

    local d = p.dot(o)

    local chained = p.scale(2.0).dot(o)

    local four = 2.double()

    // bare dot is always plain field access
    local x = p.x

    local c = Counter(0, |n| => n + 1)
    local next = (c.step)(c.count)
}